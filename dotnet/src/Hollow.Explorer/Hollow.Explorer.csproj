<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Hollow.Explorer</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Description>
      A web UI for looking through a Hollow dataset: what types it holds, what the records look like,
      and which of them match a search.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Hollow/Hollow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    The diff's stylesheet and margin images ride along in the assembly, so that an application
    embedding the UI gets a working page without serving static files of its own.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Diff/Resources/*" />
  </ItemGroup>

</Project>
