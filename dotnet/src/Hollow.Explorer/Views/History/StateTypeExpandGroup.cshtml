@*
    Java's history-state-type-expand-group.vm, which is the only page it renders without the header and
    footer: this is a fragment dropped into a div on the type page, not a page of its own.
*@
@model HistoryStateTypeExpandGroupModel
@{
	Layout = null;
}
@if (Model.ExpandedNode.HasSubGroups)
{
	<partial name="_RecordDiffGroups" model="new RecordDiffGroupsModel(Model.ExpandedNode.SubGroups)" />
}
else
{
	<partial name="_RecordDiffs"
	         model="new RecordDiffListModel(Model.BasePath, Model.Version, Model.TypeName, Model.ExpandedNode.RecordDiffs)" />
}
