@*
    A group's subgroups. Opening one fetches its contents into the empty div beside it, which is what
    keeps a type grouped three deep from drawing every record it has on the first request.
*@
@model RecordDiffGroupsModel
<ul>
	@foreach (RecordDiffTreeNode changeGroup in Model.SubGroups)
	{
		<li>
			<a href="#" data-expand-group="@changeGroup.HierarchicalFieldName">
				@changeGroup.GroupName (@changeGroup.DiffCount)
			</a>
			<div id="@changeGroup.HierarchicalFieldName"></div>
		</li>
	}
</ul>
