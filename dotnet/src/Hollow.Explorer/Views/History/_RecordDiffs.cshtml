@*
    The grid of record links, five to a row, that Java's templates repeat nine times between them —
    once per change kind on the type page, in an opened group, and in a search result.
*@
@using System.Globalization
@model RecordDiffListModel
@{
	const int RecordsPerRow = 5;
	const int MaxRecords = 5000;

	string RecordLink(RecordDiff record) =>
		Model.BasePath
		+ "/historicalObject?version=" + Model.Version.ToString(CultureInfo.InvariantCulture)
		+ "&amp;type=" + Uri.EscapeDataString(Model.TypeName)
		+ "&amp;keyOrdinal=" + record.KeyOrdinal.ToString(CultureInfo.InvariantCulture);
}
<table width="100%">
	@for (int begin = 0; begin < Model.Records.Count && begin < MaxRecords; begin += RecordsPerRow)
	{
		<tr>
			@foreach (RecordDiff record in Model.Records.Skip(begin).Take(RecordsPerRow))
			{
				<td><a href="@Html.Raw(RecordLink(record))">@record.IdentifierString</a></td>
			}
		</tr>
	}
	@*
		A type whose every record changed would otherwise write a page nobody can load. Java stops at
		the same count, and says so in the same place.
	*@
	@if (Model.Records.Count > MaxRecords)
	{
		<tr><td colspan="@RecordsPerRow" align="center"><b>(TRUNCATED AFTER @MaxRecords RECORDS)</b></td></tr>
	}
</table>
