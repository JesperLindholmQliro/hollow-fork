@*
    Java's history-state.vm. Its history-state-enhanced-ui.vm — a second, unfinished take on this page,
    reachable only by editing the page class and swapping which template it names — is not ported.
*@
@using System.Globalization
@model HistoryStateModel
@{
	Layout = "_HistoryLayout";
	string Version(long version) => version.ToString(CultureInfo.InvariantCulture);
}

<b>State: @Model.CurrentStateVersion</b>
<p></p>

@if (Model.PreviousStateVersion != HollowConstants.VersionNone)
{
	<a href="@Model.BasePath/state?version=@Version(Model.PreviousStateVersion)">&lt; prev version</a>
}
&nbsp;&nbsp;&nbsp;&nbsp;
@if (Model.NextStateVersion != HollowConstants.VersionNone)
{
	<a href="@Model.BasePath/state?version=@Version(Model.NextStateVersion)">&gt; next version</a>
}

<table border="1">
	@foreach (HistoryStateTypeChangeSummary summary in Model.TypeChanges)
	{
		<tr>
			<td>
				<a href="@Model.BasePath/statetype?version=@Version(summary.Version)&amp;type=@Uri.EscapeDataString(summary.TypeName)">
					@summary.TypeName
				</a>
			</td>
			<td>
				<table width="100%">
					<tr>
						<td align="left">@summary.TotalChanges</td>
						<td align="right">
							(&#916;: @summary.Modifications, +: @summary.Additions, -: @summary.Removals)
						</td>
					</tr>
				</table>
			</td>
		</tr>
	}
</table>

<p></p>
