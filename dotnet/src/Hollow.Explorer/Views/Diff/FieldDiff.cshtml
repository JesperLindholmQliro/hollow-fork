@* Java's diff-field.vm. *@
@model DiffFieldModel
@{
	Layout = "_DiffLayout";
	string path = Model.BasePath;
	string type = Uri.EscapeDataString(Model.TypeName);
}

<a name="objectDiffs"></a>
<h3>Object Diffs</h3>

@foreach (ObjectPairDiffScore objectPairScore in Model.ObjectScorePairs)
{
	<a href="@path/objectdiff?type=@type&amp;fieldIdx=@Model.FieldIndex&amp;fromOrdinal=@objectPairScore.FromOrdinal&amp;toOrdinal=@objectPairScore.ToOrdinal">
		@objectPairScore.DisplayKey (@objectPairScore.DiffScore)
	</a>
	<br />
}

@if (Model.PreviousDiffPairPageBeginIndex is { } previousPairs)
{
	<a href="@path/fielddiff?type=@type&amp;fieldIdx=@Model.FieldIndex&amp;diffPairBeginIdx=@previousPairs#objectDiffs">&lt;&lt; Previous</a>
}
@if (Model.NextDiffPairPageBeginIndex is { } nextPairs)
{
	<a href="@path/fielddiff?type=@type&amp;fieldIdx=@Model.FieldIndex&amp;diffPairBeginIdx=@nextPairs#objectDiffs">Next &gt;&gt;</a>
}
