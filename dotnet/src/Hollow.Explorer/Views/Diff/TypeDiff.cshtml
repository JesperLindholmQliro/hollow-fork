@* Java's diff-type.vm. *@
@model DiffTypeModel
@{
	Layout = "_DiffLayout";
	string path = Model.BasePath;
	string type = Uri.EscapeDataString(Model.TypeName);
}

Extra in @Model.FromBlobName : @Model.UnmatchedInFromCount <br />
Extra in @Model.ToBlobName : @Model.UnmatchedInToCount <br />
Total in @Model.FromBlobName : @Model.TotalInFrom <br />
Total in @Model.ToBlobName : @Model.TotalInTo <br />
Total Diff Objects: @Model.NumObjectsDiff <br />
Number of Fields With Diffs: @Model.NumFieldsWithDiffs <br />

<p></p>

<h3>
	Field Diffs
	@if (Model.ShowFields)
	{
		<text>(<a href="@path/typediff?type=@type&amp;showFields=false">hide</a>)</text>
	}
	else
	{
		<text>(<a href="@path/typediff?type=@type&amp;showFields=true">show</a>)</text>
	}
</h3>

@if (Model.ShowFields)
{
	foreach (FieldDiffScore fieldDiff in Model.FieldDiffs)
	{
		<a href="@path/fielddiff?type=@type&amp;fieldIdx=@fieldDiff.TypeFieldIndex">@fieldDiff.DisplayName</a>
		<text>(@fieldDiff.NumDiffObjects / @fieldDiff.NumTotalObjectPairs) (@fieldDiff.DiffScore)</text>
		<br />
	}
}

<a name="objectDiffs"></a>
<h3>Object Diffs</h3>

@foreach (ObjectPairDiffScore objectPairScore in Model.ObjectScorePairs)
{
	<a href="@path/objectdiff?type=@type&amp;fromOrdinal=@objectPairScore.FromOrdinal&amp;toOrdinal=@objectPairScore.ToOrdinal">
		@objectPairScore.DisplayKey (@objectPairScore.DiffScore)
	</a>
	<br />
}

@if (Model.PreviousDiffPairPageBeginIndex is { } previousPairs)
{
	<a href="@path/typediff?type=@type&amp;diffPairBeginIdx=@previousPairs#objectDiffs">&lt;&lt; Previous</a>
}
@if (Model.NextDiffPairPageBeginIndex is { } nextPairs)
{
	<a href="@path/typediff?type=@type&amp;diffPairBeginIdx=@nextPairs#objectDiffs">Next &gt;&gt;</a>
}

<a name="unmatchedObjects"></a>
<h3>Unmatched Objects</h3>

<table border="1" cellpadding="5">
	<tr>
		<th>Unmatched in @Model.FromBlobName (@Model.UnmatchedInFromCount)</th>
		<th>Unmatched in @Model.ToBlobName (@Model.UnmatchedInToCount)</th>
	</tr>
	<tr>
		<td>
			@*
				A record the later state does not have is shown against nothing, which is what the -1
				ordinal on the other side means.
			*@
			@foreach (UnmatchedObject unmatched in Model.UnmatchedFromObjects)
			{
				<a href="@path/objectdiff?type=@type&amp;fromOrdinal=@unmatched.Ordinal&amp;toOrdinal=-1">@unmatched.DisplayKey</a>
				<br />
			}
			@if (Model.PreviousUnmatchedFromPageBeginIndex is { } previousFrom)
			{
				<a href="@path/typediff?type=@type&amp;unmatchedFromBeginIdx=@previousFrom#unmatchedObjects">&lt;&lt; Previous</a>
			}
			@if (Model.NextUnmatchedFromPageBeginIndex is { } nextFrom)
			{
				<a href="@path/typediff?type=@type&amp;unmatchedFromBeginIdx=@nextFrom#unmatchedObjects">Next &gt;&gt;</a>
			}
		</td>
		<td>
			@foreach (UnmatchedObject unmatched in Model.UnmatchedToObjects)
			{
				<a href="@path/objectdiff?type=@type&amp;fromOrdinal=-1&amp;toOrdinal=@unmatched.Ordinal">@unmatched.DisplayKey</a>
				<br />
			}
			@if (Model.PreviousUnmatchedToPageBeginIndex is { } previousTo)
			{
				<a href="@path/typediff?type=@type&amp;unmatchedToBeginIdx=@previousTo#unmatchedObjects">&lt;&lt; Previous</a>
			}
			@if (Model.NextUnmatchedToPageBeginIndex is { } nextTo)
			{
				<a href="@path/typediff?type=@type&amp;unmatchedToBeginIdx=@nextTo#unmatchedObjects">Next &gt;&gt;</a>
			}
		</td>
	</tr>
</table>
