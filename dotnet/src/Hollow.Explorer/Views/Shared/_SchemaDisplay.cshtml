@* The #showSchema macro of Java's browse-schema.vm, which calls itself for each open branch. *@
@model SchemaDisplayModel
@{
	string typeName = Model.Display.TypeName;
}
<ul>
	@foreach (SchemaDisplayField field in Model.Display.Fields)
	{
		<li>
			<span style="font-family: monospace;">
				@if (field.ReferencedType is { } referenced)
				{
					@* The link does the opposite of what the branch currently is. *@
					string action = referenced.IsExpanded ? "collapse" : "expand";

					<a href="@Model.BasePath/schema?@Html.Raw(Model.TypesQuery)&amp;@action=@Uri.EscapeDataString(field.FieldPath)">@field.FieldName</a>

					<text>(@referenced.TypeName - @referenced.Schema.SchemaType)</text>
				}
				else
				{
					<text>@field.FieldName (@field.FieldType)</text>
				}

				@if (field.IsSearchable)
				{
					<a href="@Model.BasePath/query?type=@Uri.EscapeDataString(typeName)&amp;field=@Uri.EscapeDataString(field.FieldName)">search</a>
				}
			</span>

			@if (field.ReferencedType is { IsExpanded: true } expanded)
			{
				@await Html.PartialAsync("_SchemaDisplay", Model.For(expanded))
			}
		</li>
	}
</ul>
