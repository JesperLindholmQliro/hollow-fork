@*
    Java's history-header.vm and history-footer.vm, which every page was merged between.

    The header's script is gone. It toggled the header table's visibility and expanded every row of a
    record page; a details element does the first, and the second worked by reading each row's onclick
    handler back as a string and looking for a function name inside it.
*@
@model HistoryPageModel
<!DOCTYPE html>
<html lang="en">
<head>
	<title>Hollow Data History</title>
	<style>
		.nav { text-align: left; padding-left: 5px; padding-right: 80px; border-left: 1px solid #DCDCDC; }
	</style>
</head>
<body>

<table>
	<tr>
		@if (Model.ShowHomeLink)
		{
			<td class="nav"><a href="@Model.BasePath/overview">Home</a></td>
		}
		@foreach (string entry in Model.CommonHeaderEntries)
		{
			@*
				A host's own header cells are markup it wrote, so they go out as written. Nothing a
				reader supplies reaches here.
			*@
			@Html.Raw(entry)
		}
	</tr>
</table>

<form action="@Model.BasePath/query">
	Lookup Key:
	<input type="text" name="query" />
	<input type="submit" />
</form>

@if (Model.HeaderEntries.Count > 0)
{
	<details>
		<summary>Blob headers</summary>
		<table border="1" cellpadding="5">
			<tr><th>#</th><th>Header Name</th><th>FROM_Blob</th><th>TO_Blob</th></tr>
			@foreach (DiffHeaderEntry headerEntry in Model.HeaderEntries)
			{
				<tr bgcolor="@headerEntry.BackgroundColor">
					<td align="right">@headerEntry.Index</td>
					<td>@headerEntry.Key</td>
					<td>@headerEntry.FromValueDisplay</td>
					<td>@headerEntry.ToValueDisplay</td>
				</tr>
			}
		</table>
	</details>
}

<hr />

@RenderBody()

</body>
</html>
