@* Java's query.vm. *@
@model QueryPageModel

@if (Model.QueryResult is not null)
{
	<b>Augment Current Query:</b>
}
else
{
	<b>Search:</b>
}

<form action="@Model.BasePath/query">

	<table>
		<tr>
			<th>Type:</th>
			<th>Field Name:</th>
			<th>Field Value:</th>
			<td />
		</tr>
		<tr>
			<td>
				<select name="type">
					<option>ANY TYPE</option>
					@foreach (string type in Model.AllTypes)
					{
						<option selected="@(type == Model.SelectedType)">@type</option>
					}
				</select>
			</td>
			<td><input type="text" name="field" value="@Model.SelectedField"></td>
			<td><input type="text" name="queryValue" size="85"></td>
			<td><input type="submit"></td>
		</tr>
	</table>

</form>

@if (Model.QueryResult is { } queryResult)
{
	<text>Current Query: <span style="font-family: monospace;">@queryResult.QueryDisplayString</span> <a href="@Model.BasePath/query?clear=true">clear</a></text>

	<p/>

	<text>RESULTS:</text>

	<ul>
		@foreach (QueryTypeMatches typeMatches in queryResult.TypeMatches)
		{
			<li>
				<span style="font-family: monospace;">
					<a href="@Model.BasePath/type?type=@Uri.EscapeDataString(typeMatches.TypeName)">@typeMatches.TypeName</a>: @typeMatches.NumMatches records match
				</span>
			</li>
		}
	</ul>
}
