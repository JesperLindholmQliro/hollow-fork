<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Hollow.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The Java tests exercise plenty of intentionally unused locals and boundary values. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The code generator's tests compile its output in process and run it, which is the only way to
      know the emitted text is valid C# that does what it claims. Java's equivalent shells out to the
      JDK compiler and only checks that it compiles.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Hollow/Hollow.csproj" />
    <!--
      The explorer's tests drive it as a running web application rather than calling its controller, so
      that the views are exercised too — which is where most of what was ported from Velocity lives.
    -->
    <ProjectReference Include="../../src/Hollow.Explorer/Hollow.Explorer.csproj" />
    <!--
      Referenced as an ordinary assembly rather than as an analyser: the tests drive the generator
      through CSharpGeneratorDriver, which needs the type. The emitter source it shares with Hollow is
      internal on both sides, so the two copies do not collide.
    -->
    <ProjectReference Include="../../src/Hollow.SourceGenerator/Hollow.SourceGenerator.csproj" />
  </ItemGroup>

</Project>
