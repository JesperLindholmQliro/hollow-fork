<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Hollow.DiffUI.Sample</RootNamespace>

    <!-- A sample explains itself in prose rather than in XML doc comments. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The diff UI lives in the explorer assembly, since the two share their MVC plumbing. Nothing
         else is needed: a diff is read from schemas, not from generated classes. -->
    <ProjectReference Include="../../src/Hollow.Explorer/Hollow.Explorer.csproj" />
  </ItemGroup>

</Project>
