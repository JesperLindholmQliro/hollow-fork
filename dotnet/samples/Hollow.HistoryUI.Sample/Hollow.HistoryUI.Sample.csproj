<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Hollow.HistoryUI.Sample</RootNamespace>

    <!-- A sample explains itself in prose rather than in XML doc comments. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The history UI lives in the explorer assembly, since the three UIs share their MVC plumbing
         and the history's record page is the diff's. Nothing else is needed: a history is read from
         schemas, not from generated classes. -->
    <ProjectReference Include="../../src/Hollow.Explorer/Hollow.Explorer.csproj" />
  </ItemGroup>

</Project>
