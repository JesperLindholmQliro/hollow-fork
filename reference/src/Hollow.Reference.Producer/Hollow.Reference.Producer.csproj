<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Hollow.Reference.Producer</RootNamespace>
    <UserSecretsId>hollow-reference-producer</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Hollow.Reference.Infrastructure/Hollow.Reference.Infrastructure.csproj" />
    <ProjectReference Include="../Hollow.Reference.Model/Hollow.Reference.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- One settings file for both applications, linked rather than copied, so that switching mode
         switches it for the producer and the consumer together. -->
    <Content Include="../../appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
