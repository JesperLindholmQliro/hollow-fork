<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Hollow.Reference.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../dotnet/src/Hollow/Hollow.csproj" />
  </ItemGroup>

  <ItemGroup Label="Configuration and hosting">
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!--
    All three modes ship in one assembly, so switching mode is a configuration change and not a
    different build. The cost is that a deployment running only the local mode still carries the cloud
    SDKs; splitting them into Hollow.Reference.Infrastructure.Aws and .Azure is the obvious next step
    for a real service, and nothing outside this project would have to change.
  -->
  <ItemGroup Label="AWS mode">
    <PackageReference Include="AWSSDK.Core" />
    <PackageReference Include="AWSSDK.DynamoDBv2" />
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <ItemGroup Label="Azure mode">
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>

</Project>
