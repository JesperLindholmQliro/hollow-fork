<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- A reference implementation explains itself in prose rather than in XML doc comments, so there
         is nothing worth shipping an XML file for. The comments are still written; they are just not
         a published API surface. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Hollow Reference Implementation</Product>
    <Company>Netflix, Inc.</Company>
    <Copyright>Copyright 2016-2019 Netflix, Inc.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

</Project>
