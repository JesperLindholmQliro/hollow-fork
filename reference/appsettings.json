// The one place the producer and the consumer are configured. Both projects link this file rather
// than keeping a copy, so switching infrastructure switches it for both of them at once.
//
// Comments and trailing commas are legal here: .NET's JSON configuration provider skips them.
{
  // Which infrastructure to run against: "Local", "Aws" or "Azure". Every branch below stays in the
  // file whichever is chosen; only the one named here is read.
  "Hollow": {
    "Mode": "Local",

    // The prefix every blob key is written under, so one bucket or container can hold more than one
    // dataset. Called the blob namespace in the Java reference implementation.
    "Namespace": "hollow-reference",

    // ── Local: a directory, and a watching folder in place of an announcement table ───────────────
    "Local": {
      // Where blobs and announcements go. Left out, it is <temp>/hollow-reference — which is what
      // makes the producer and the consumer find each other with nothing configured at all, the same
      // trick the Java original plays with java.io.tmpdir.
      // "RootPath": "/var/tmp/hollow-reference",

      // How many announcement files to keep in the watching folder. The newest is the announced
      // version; the rest are only there because a producer cycling every ten seconds would otherwise
      // fill the directory.
      "AnnouncementsToKeep": 50,

      // A pretend network. Without it the local mode answers in microseconds and never reproduces the
      // races a real deployment has. Zero both to turn it off.
      "Latency": {
        "PerOperation": "00:00:00.025",
        "PerMegabyte": "00:00:00.040"
      }
    },

    // ── AWS: S3 and DynamoDB, the services the Java reference implementation uses ─────────────────
    "Aws": {
      // Left out, the region and the credentials come from the environment the usual way: AWS_REGION,
      // the shared config file, or the instance role.
      "Region": "eu-north-1",
      // "Profile": "hollow",

      "BucketName": "hollow-reference-blobs",

      // A table with a single string partition key called "namespace". Nothing else to provision.
      "TableName": "hollow-reference-announcements",

      // Point these at LocalStack or MinIO to run the AWS mode without an AWS account.
      // "ServiceUrl": "http://localhost:4566",
      // "ForcePathStyle": true,

      "PollInterval": "00:00:01"
    },

    // ── Azure: Blob Storage and Table Storage, both in one storage account ────────────────────────
    "Azure": {
      // Either a connection string, or the two service URIs plus whatever DefaultAzureCredential
      // finds — a managed identity in Azure, the az CLI login on a developer's machine.
      // "ConnectionString": "UseDevelopmentStorage=true",
      "BlobServiceUri": "https://hollowreference.blob.core.windows.net",
      "TableServiceUri": "https://hollowreference.table.core.windows.net",

      "ContainerName": "hollow-reference-blobs",
      "TableName": "hollowreferenceannouncements",

      "PollInterval": "00:00:01"
    },

    // ── The producer ─────────────────────────────────────────────────────────────────────────────
    "Producer": {
      // The least time between the start of one cycle and the start of the next.
      "CycleInterval": "00:00:10",

      // Restore the last announced version before the first cycle, so a restarted producer publishes
      // a delta rather than an unrelated snapshot.
      "RestoreOnStartup": true,

      // Zero means cycle until interrupted.
      "MaxCycles": 0,

      // The fake catalogue. The Java original hard-codes 999 actors and 10,000 films; both are worth
      // turning down while trying things out, because every cycle writes all of them.
      "Source": {
        "ActorCount": 999,
        "MovieCount": 10000
        // "Seed": 20160101
      }
    },

    // ── The consumer ─────────────────────────────────────────────────────────────────────────────
    "Consumer": {
      "ExplorerBasePath": "/explorer",
      "HistoryBasePath": "/history",

      // How many past versions the history holds before dropping the oldest. A memory budget: each
      // one costs whatever that transition changed.
      "MaxHistoricalStates": 1024
    }
  },

  // Where the consumer's web application listens. The producer has no web surface and ignores this.
  "Urls": "http://127.0.0.1:7780",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
